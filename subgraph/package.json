{
  "name": "@paramshield/subgraph",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "spike:cli": "graph --version",
    "codegen": "graph codegen",
    "build": "pnpm build:v1 && pnpm build:v2",
    "build:v1": "graph codegen && graph build",
    "build:v2": "graph codegen v2/subgraph.yaml --output-dir generated/v2 && graph build v2/subgraph.yaml --output-dir build/v2"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  }
}
